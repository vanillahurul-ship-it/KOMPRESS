# VPS deployment environment for docker-compose.yml.
# On the VPS: copy this to `.env` in the same directory as docker-compose.yml and
# fill in the real values. This file only holds placeholders and is safe to commit.

# --- GHCR image source ---
GHCR_OWNER=your-github-username
IMAGE_TAG=latest

# --- Backend runtime ---
PORT=5000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
FRONTEND_URL=http://your-vps-ip-or-domain
